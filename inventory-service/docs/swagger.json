                "catalog_product_id": {
                    "type": "string",
                    "format": "uuid"
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "FOOD",
                        "MEDICINE",
                        "HOUSEHOLD"
                    ],
                    "example": "FOOD"
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "gtin": {
                    "type": "string",
                    "example": "04600634855338"
                },
                "id": {
                    "type": "string",
                    "format": "uuid"
                },
                "image_url": {
                    "type": "string",
                    "format": "uri"
                },
                "is_low_stock": {
                    "type": "boolean",
                    "example": false
                },
                "minimum_quantity": {
                    "type": "string",
                    "example": "500.000"
                },
                "name": {
                    "type": "string",
                    "example": "Молоко 930 мл"
