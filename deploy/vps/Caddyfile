{$API_DOMAIN} {
	request_body {
		max_size 1MB
	}

	# Preserve the order: global budget, per-IP budget, then path rewriting.
	route {
		# Bound requests before allocating per-IP limiter state.
		rate_limit {
			sweep_interval 5s
			zone auth_global {
				match {
					method POST
					path /api/v1/auth/login /api/v1/auth/register /api/v1/auth/guest-login /api/v1/auth/link-guest
				}
				match {
					method PATCH
					path /api/v1/auth/password /api/v1/auth/email
				}
				key auth
				window 1s
				events 10
			}
		}

		# Shared across routes: at most 5 requests per IP in any 5-second window.
		rate_limit {
			sweep_interval 5s
			zone auth_per_ip {
				match {
					method POST
					path /api/v1/auth/login /api/v1/auth/register /api/v1/auth/guest-login /api/v1/auth/link-guest
				}
				match {
					method PATCH
					path /api/v1/auth/password /api/v1/auth/email
				}
				key {remote_host}
				window 5s
				events 5
			}
		}

		handle_path /api/v1/auth/* {
			reverse_proxy auth-service:8080 {
				# Caddy is the public edge; do not accept client-supplied IP headers.
				header_up -True-Client-IP
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
			}
		}

		handle /healthz {
			reverse_proxy auth-service:8080
		}

		handle {
			respond "Not found" 404
		}
	}
}
